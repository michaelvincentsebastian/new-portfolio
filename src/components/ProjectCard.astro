---
import Icon from "./Icon.astro";
import { t } from "../data/i18n.js";

const { project, lang } = Astro.props;
const { title, tagline, year, status, techStack, cover } = project.data;
const label = t(lang).projects;
---

<a
  href={`/${lang}/projects/${project.data.projectSlug}`}
  class="group flex flex-col overflow-hidden rounded-xl border border-border/80 bg-card/50 transition-all duration-200 hover:border-accent/40 hover:-translate-y-[2px] hover:bg-card hover:shadow-sm"
>
  {cover && (
    <div class="aspect-video w-full overflow-hidden bg-muted border-b border-border/50">
      <img
        src={cover}
        alt={title}
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.015]"
        loading="lazy"
      />
    </div>
  )}
  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-lg font-bold text-foreground group-hover:text-accent transition-colors">{title}</h3>
      <span class="shrink-0 text-xs font-mono font-medium text-muted-foreground bg-muted/60 px-2 py-0.5 rounded border border-border/40">{year}</span>
    </div>
    <p class="mt-2.5 flex-1 text-sm leading-relaxed text-muted-foreground text-pretty">{tagline}</p>
    <div class="mt-5 flex flex-wrap gap-2">
      {techStack.slice(0, 4).map((tech) => (
        <span class="rounded bg-muted px-2 py-0.5 text-[10px] font-mono font-medium text-muted-foreground border border-border/40">
          {tech}
        </span>
      ))}
    </div>
    <span class="mt-6 inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-accent">
      {label.viewProject}
      <Icon name="external-link" size={12} />
    </span>
  </div>
</a>
