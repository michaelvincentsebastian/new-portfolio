---
import Icon from "./Icon.astro";
import { t } from "../data/i18n.js";

const { lang, altHref, isProjectPage = false } = Astro.props;
const nav = t(lang).nav;

// Di homepage, link nav berupa jump link (#home dst).
// Di halaman detail project, link nav mengarah balik ke homepage + jump link.
const base = isProjectPage ? `/${lang}/` : "";

const navItems = [
  { id: "home", icon: "home", label: nav.home },
  { id: "aboutme", icon: "user", label: nav.about },
  { id: "skills", icon: "sliders", label: nav.skills || nav.techStack },
  { id: "projects", icon: "code", label: nav.projects },
  { id: "experience", icon: "route", label: nav.experience },
  { id: "contact", icon: "mail", label: nav.contact },
];

const otherLang = lang === "en" ? "id" : "en";
---

<!-- Desktop Sidebar -->
<nav class="fixed left-4 top-1/2 z-50 hidden -translate-y-1/2 flex-col items-center gap-2 md:flex">
  <div class="flex flex-col items-center gap-2 rounded-2xl bg-card/80 p-2 backdrop-blur-xl border border-border">
    {navItems.map((item) => (
      <a
        href={`${base}#${item.id}`}
        aria-label={item.label}
        title={item.label}
        class="flex h-12 w-12 items-center justify-center rounded-xl text-muted-foreground transition-colors duration-200 hover:text-accent hover:bg-muted"
      >
        <Icon name={item.icon} size={20} />
      </a>
    ))}
  </div>

  <div class="mt-2 flex flex-col items-center gap-2 rounded-2xl bg-card/80 p-2 backdrop-blur-xl border border-border">
    <button
      id="theme-toggle"
      type="button"
      aria-label="Toggle theme"
      class="flex h-10 w-10 items-center justify-center rounded-xl text-muted-foreground transition-colors hover:text-foreground hover:bg-muted"
    >
      <Icon name="sun" size={18} class="hidden dark:block" />
      <Icon name="moon" size={18} class="block dark:hidden" />
    </button>
    <a
      href={altHref}
      aria-label="Toggle language"
      class="flex h-10 w-10 items-center justify-center rounded-xl text-muted-foreground transition-colors hover:text-foreground hover:bg-muted"
    >
      <span class="text-xs font-bold font-mono">{otherLang.toUpperCase()}</span>
    </a>
  </div>
</nav>

<!-- Mobile Bottom Nav -->
<nav class="fixed bottom-4 left-1/2 z-50 flex -translate-x-1/2 md:hidden">
  <div class="flex items-center gap-1 rounded-2xl bg-card/90 p-2 backdrop-blur-xl border border-border">
    {navItems.map((item) => (
      <a
        href={`${base}#${item.id}`}
        aria-label={item.label}
        class="flex h-10 w-10 items-center justify-center rounded-xl text-muted-foreground transition-colors hover:text-accent"
      >
        <Icon name={item.icon} size={18} />
      </a>
    ))}
    <div class="mx-1 h-6 w-px bg-border"></div>
    <button
      id="theme-toggle-mobile"
      type="button"
      aria-label="Toggle theme"
      class="flex h-10 w-10 items-center justify-center rounded-xl text-muted-foreground"
    >
      <Icon name="sun" size={16} class="hidden dark:block" />
      <Icon name="moon" size={16} class="block dark:hidden" />
    </button>
    <a
      href={altHref}
      aria-label="Toggle language"
      class="flex h-10 w-10 items-center justify-center rounded-xl text-muted-foreground"
    >
      <span class="text-[10px] font-bold font-mono">{otherLang.toUpperCase()}</span>
    </a>
  </div>
</nav>

<script is:inline>
  // Toggle dark/light, disimpan di localStorage. Tidak pakai framework apapun.
  function toggleTheme() {
    const html = document.documentElement;
    const isDark = html.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  }
  document.getElementById("theme-toggle")?.addEventListener("click", toggleTheme);
  document.getElementById("theme-toggle-mobile")?.addEventListener("click", toggleTheme);
</script>
