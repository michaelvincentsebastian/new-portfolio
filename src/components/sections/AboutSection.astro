---
import Icon from "../Icon.astro";
import { t } from "../../data/i18n.js";

const { lang } = Astro.props;
const about = t(lang).about;
---

<section id="aboutme" class="scroll-mt-24 py-20">
  <!-- Section Header -->
  <div class="animate-fade-up mb-12">
    <div class="flex items-center gap-4 mb-3">
      <h2 class="text-3xl font-bold text-foreground md:text-4xl tracking-tight flex items-center gap-2.5">
        <Icon name="user" class="text-accent" size={28} />
        <span>{about.title} <span class="text-accent">{about.titleAccent}</span></span>
      </h2>
      <div class="h-px flex-1 bg-border/80"></div>
    </div>
  </div>

  <!-- Content Grid -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
    <!-- Profile Picture Column -->
    <div class="col-span-12 md:col-span-5 lg:col-span-4 animate-fade-up">
      <div class="relative group mx-auto max-w-[280px] md:max-w-none">
        <!-- Image wrapper -->
        <div class="relative overflow-hidden rounded-xl border border-border bg-card p-1.5 shadow-sm transition-all duration-200 group-hover:border-accent/40">
          <img
            src="/images/profile-picture.webp"
            alt="Michael Vincent Sebastian Handojo"
            class="h-full w-full object-cover rounded-lg aspect-[3/4] transition duration-200 group-hover:scale-[1.01]"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <!-- About Text & Side Tabs Column -->
    <div class="col-span-12 md:col-span-7 lg:col-span-8 flex flex-col md:flex-row gap-6 md:gap-8 animate-fade-up items-start">
      <!-- Side Tab Buttons -->
      <div class="flex flex-row md:flex-col gap-1.5 border-b md:border-b-0 md:border-l border-border/60 pb-3 md:pb-0 md:pl-2 w-full md:w-48 shrink-0 overflow-x-auto scrollbar-none md:overflow-x-visible">
        {about.tabLabels.map((label, index) => (
          <button
            class={`about-tab-btn w-auto md:w-full px-4 py-2.5 text-sm font-semibold text-left whitespace-nowrap transition-all duration-200 cursor-pointer rounded-lg md:rounded-l-none ${
              index === 0
                ? "bg-accent/10 text-accent border border-accent/25 md:border-0 md:border-l-2 md:border-accent md:pl-3.5 md:bg-accent/5 md:rounded-r-lg"
                : "border border-transparent text-muted-foreground hover:text-foreground hover:bg-muted/40 md:pl-4"
            }`}
            data-tab={index}
          >
            {label}
          </button>
        ))}
      </div>

      <!-- Tab Contents -->
      <div class="flex-1 w-full bg-card/50 border border-border/80 rounded-xl p-6 md:p-8 min-h-[220px]">
        {about.paragraphs.map((paragraph, index) => (
          <div
            class={`about-tab-content transition-opacity duration-200 ${
              index === 0 ? "block opacity-100" : "hidden opacity-0"
            }`}
            data-content={index}
          >
            <p class="text-base leading-relaxed text-muted-foreground text-pretty">
              {paragraph}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const tabBtns = document.querySelectorAll(".about-tab-btn");
    const tabContents = document.querySelectorAll(".about-tab-content");

    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const selectedTab = btn.getAttribute("data-tab");

        // Update active classes on buttons
        tabBtns.forEach((b) => {
          b.classList.remove(
            "bg-accent/10",
            "text-accent",
            "border-accent/25",
            "md:border-l-2",
            "md:border-accent",
            "md:pl-3.5",
            "md:bg-accent/5",
            "md:rounded-r-lg"
          );
          b.classList.add("border-transparent", "text-muted-foreground", "hover:text-foreground", "hover:bg-muted/40", "md:pl-4");
        });

        // Add active classes to selected button
        btn.classList.remove("border-transparent", "text-muted-foreground", "hover:text-foreground", "hover:bg-muted/40", "md:pl-4");
        btn.classList.add(
          "bg-accent/10",
          "text-accent",
          "border-accent/25",
          "md:border-l-2",
          "md:border-accent",
          "md:pl-3.5",
          "md:bg-accent/5",
          "md:rounded-r-lg"
        );

        // Switch visible content block
        tabContents.forEach((content) => {
          const contentId = content.getAttribute("data-content");
          if (contentId === selectedTab) {
            content.classList.remove("hidden");
            content.classList.add("block");
            // Trigger animation fade in
            setTimeout(() => {
              content.classList.remove("opacity-0");
              content.classList.add("opacity-100");
            }, 10);
          } else {
            content.classList.add("hidden");
            content.classList.remove("block", "opacity-100");
            content.classList.add("opacity-0");
          }
        });
      });
    });
  })();
</script>
