---
import { t } from "../../data/i18n.js";
const { lang } = Astro.props;
const experience = t(lang).experience;
---

<section id="experience" class="scroll-mt-24 py-20">
  <div class="animate-fade-up">
    <h2 class="text-4xl font-bold text-foreground md:text-5xl text-balance">
      {experience.title} <span class="text-accent">{experience.titleAccent}</span>
    </h2>
    <p class="mt-4 max-w-xl text-base leading-relaxed text-muted-foreground text-pretty">
      {experience.description}
    </p>
  </div>

  <ol class="mt-12 flex flex-col gap-8 border-l-2 border-border pl-6">
    {experience.items.map((item) => (
      <li class="relative animate-fade-up">
        <span class="absolute -left-[31px] top-1.5 h-3 w-3 rounded-full border-2 border-accent bg-background"></span>
        <p class="text-xs font-bold uppercase tracking-wider text-accent">{item.date}</p>
        <h3 class="mt-1 text-base font-semibold text-foreground">{item.title}</h3>
        <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{item.description}</p>
      </li>
    ))}
  </ol>
</section>
