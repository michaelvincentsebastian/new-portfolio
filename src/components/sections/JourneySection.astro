---
import { getCollection, render } from "astro:content";
import Icon from "../Icon.astro";
import { t } from "../../data/i18n.js";

const { lang } = Astro.props;
const journeyText = t(lang).journey;

// Fetch all experiences
const allExperiences = await getCollection("experience");
const experiences = allExperiences.filter((exp) => exp.data.lang === lang);

// Resolve all rendering Content components
const experiencesWithContent = await Promise.all(
  experiences.map(async (exp) => {
    const rendered = await render(exp);
    return {
      ...exp,
      Content: rendered.Content,
    };
  })
);
---

<section id="journey" class="scroll-mt-24 py-20">
  <!-- Section Header -->
  <div class="animate-fade-up">
    <h2 class="text-4xl font-bold text-foreground md:text-5xl text-balance">
      {journeyText.title} <span class="text-accent">{journeyText.titleAccent}</span>
    </h2>
    <p class="mt-4 max-w-xl text-base leading-relaxed text-muted-foreground text-pretty">
      {journeyText.description}
    </p>
  </div>

  <!-- Two columns: Timeline and Awards -->
  <div class="mt-12 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
    <!-- Left Column: Timeline (span 7) -->
    <div class="lg:col-span-7 animate-fade-up">
      <div class="flex items-center gap-4 mb-8">
        <h3 class="text-xl font-bold text-foreground whitespace-nowrap">
          {journeyText.timelineTitle}
        </h3>
        <div class="h-px flex-1 bg-border/80"></div>
      </div>
      <ol class="relative border-l-2 border-border/80 pl-6 flex flex-col gap-8">
        {journeyText.items.map((item) => (
          <li class="relative group cursor-pointer">
            <!-- Bullet -->
            <span class="absolute -left-[31px] top-1.5 h-3 w-3 rounded-full border-2 border-border bg-background transition-all duration-300 group-hover:border-accent group-hover:bg-accent"></span>
            
            <!-- Content Card -->
            <div 
              class="journey-item-card rounded-xl border border-border/80 bg-card/50 p-5 transition-all duration-200 hover:border-accent/40 hover:bg-card hover:shadow-sm"
              data-exp-id={item.id}
            >
              <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-semibold uppercase tracking-wider text-accent">{item.date}</span>
                <!-- Small hint icon -->
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted-foreground opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </div>
              <h3 class="mt-2 text-lg font-bold text-foreground group-hover:text-accent transition-colors">{item.title}</h3>
              <p class="mt-1 text-sm text-muted-foreground">{item.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <!-- Right Column: Awards & Medals (span 5) -->
    <div class="lg:col-span-5 flex flex-col gap-6 animate-fade-up">
      <div class="flex items-center gap-4 mb-2">
        <h3 class="text-xl font-bold text-foreground whitespace-nowrap">
          {journeyText.awardsTitle} <span class="text-accent">{journeyText.awardsTitleAccent}</span>
        </h3>
        <div class="h-px flex-1 bg-border/80"></div>
      </div>
      
      <div class="flex flex-col gap-4">
        {journeyText.awards.map((award) => (
          <div class="flex items-start gap-4 rounded-xl border border-border/80 bg-card/50 p-5 transition-all duration-200 hover:border-accent/40 hover:bg-card hover:shadow-sm">
            <!-- Trophy Icon Badge -->
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              </svg>
            </div>
            <div>
              <h4 class="text-sm font-bold text-foreground">{award.title}</h4>
              <p class="mt-1 text-xs text-muted-foreground leading-relaxed">{award.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Detailed Modal (Popup) -->
<div
  id="journey-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-background/70 backdrop-blur-md transition-opacity duration-300 opacity-0"
>
  <div 
    id="journey-modal-content"
    class="relative w-full max-w-lg scale-95 transform rounded-xl border border-border bg-card p-6 md:p-8 shadow-xl transition-all duration-200 mx-4"
  >
    <!-- Close button -->
    <button
      id="close-journey-modal"
      class="absolute right-4 top-4 rounded-lg p-1 text-muted-foreground hover:bg-muted hover:text-foreground transition-colors cursor-pointer"
      aria-label="Close"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="flex flex-col gap-4">
      <div>
        <span id="modal-period" class="text-xs font-semibold uppercase tracking-wider text-accent"></span>
        <h4 id="modal-title" class="text-xl font-bold text-foreground mt-1"></h4>
        <p id="modal-institution" class="text-sm text-muted-foreground font-semibold mt-0.5"></p>
      </div>
      
      <div class="h-px bg-border/80 my-1"></div>

      <!-- Rendered markdown description inside premium styling wrapper -->
      <div id="modal-body" class="markdown-content text-sm leading-relaxed text-muted-foreground"></div>
    </div>
  </div>
</div>

<!-- Hidden templates container containing the pre-rendered HTML content of all experiences -->
<div class="hidden" style="display: none;" aria-hidden="true">
  {experiencesWithContent.map((item) => (
    <div 
      id={`template-${item.data.id}`} 
      data-period={item.data.period} 
      data-title={item.data.title} 
      data-institution={item.data.institution}
    >
      <item.Content />
    </div>
  ))}
</div>

<script is:inline>
  (() => {
    const modal = document.getElementById("journey-modal");
    const modalContent = document.getElementById("journey-modal-content");
    const closeBtn = document.getElementById("close-journey-modal");
    const cards = document.querySelectorAll(".journey-item-card");

    const modalTitle = document.getElementById("modal-title");
    const modalPeriod = document.getElementById("modal-period");
    const modalInstitution = document.getElementById("modal-institution");
    const modalBody = document.getElementById("modal-body");

    function openModal(expId) {
      if (!modal || !modalContent) return;
      
      const template = document.getElementById(`template-${expId}`);
      if (!template) return;

      // Populate data
      modalTitle.textContent = template.getAttribute("data-title");
      modalPeriod.textContent = template.getAttribute("data-period");
      modalInstitution.textContent = template.getAttribute("data-institution");
      modalBody.innerHTML = template.innerHTML;

      // Open animations
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      setTimeout(() => {
        modal.classList.remove("opacity-0");
        modal.classList.add("opacity-100");
        modalContent.classList.remove("scale-95");
        modalContent.classList.add("scale-100");
      }, 10);
    }

    function closeModal() {
      if (!modal || !modalContent) return;
      modal.classList.remove("opacity-100");
      modal.classList.add("opacity-0");
      modalContent.classList.remove("scale-100");
      modalContent.classList.add("scale-95");
      setTimeout(() => {
        modal.classList.remove("flex");
        modal.classList.add("hidden");
      }, 300);
    }

    cards.forEach((card) => {
      card.addEventListener("click", () => {
        const expId = card.getAttribute("data-exp-id");
        openModal(expId);
      });
    });

    closeBtn?.addEventListener("click", closeModal);
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });
  })();
</script>
