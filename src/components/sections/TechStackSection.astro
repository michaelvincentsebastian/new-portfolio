---
import { t } from "../../data/i18n.js";
import { techStackData } from "../../data/techstack.js";

const { lang } = Astro.props;
const skills = t(lang).skills || t(lang).techStack;
const categoryNames = skills.categories;
---

<section id="techstack" class="scroll-mt-24 py-20">
  <!-- Section Header -->
  <div class="animate-fade-up mb-10">
    <div class="flex items-center gap-4 mb-3">
      <h2 class="text-3xl font-bold text-foreground md:text-4xl tracking-tight">
        {skills.title}
      </h2>
      <div class="h-px flex-1 bg-border/80"></div>
    </div>
    <p class="max-w-2xl text-sm md:text-base leading-relaxed text-muted-foreground text-pretty">
      {skills.description}
    </p>
  </div>

  <!-- Category Grid ("Per Kotak") -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    {techStackData.map((category) => (
      <div class="animate-fade-up flex flex-col justify-between rounded-2xl border border-border/70 bg-card/40 p-5 backdrop-blur-xs transition-all duration-300 hover:border-accent/40 hover:bg-card/70 hover:shadow-[0_4px_20px_-4px_rgba(6,182,212,0.12)]">
        <div>
          <h3 class="text-xs font-bold tracking-wider text-muted-foreground uppercase mb-4">
            {categoryNames[category.key]}
          </h3>
          <div class="flex flex-wrap gap-2.5">
            {category.items.map((item) => (
              <div class="group relative inline-flex items-center gap-2 rounded-xl border border-border/60 bg-background/80 px-3 py-2 text-xs font-medium text-foreground transition-all duration-200 hover:border-accent/50 hover:bg-card hover:scale-[1.02] shadow-2xs">
                <img
                  src={item.icon}
                  alt={item.name}
                  class="h-4 w-4 object-contain transition-transform duration-200 group-hover:scale-110"
                  loading="lazy"
                />
                <span>{item.name}</span>
                {item.soon && (
                  <span class="ml-0.5 rounded bg-accent/10 px-1.5 py-0.5 text-[9px] font-semibold text-accent">
                    Soon
                  </span>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
