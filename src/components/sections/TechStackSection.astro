---
import { t } from "../../data/i18n.js";
import { techStackData } from "../../data/techstack.js";

const { lang } = Astro.props;
const techStack = t(lang).techStack;
const categoryNames = techStack.categories;
---

<section id="techstack" class="scroll-mt-24 py-20">
  <div class="animate-fade-up">
    <h2 class="text-4xl font-bold text-foreground md:text-5xl text-balance">
      {techStack.title} <span class="text-accent">{techStack.titleAccent}</span>
    </h2>
    <p class="mt-4 max-w-xl text-base leading-relaxed text-muted-foreground text-pretty">
      {techStack.description}
    </p>
  </div>

  <div class="mt-12 flex flex-col gap-10">
    {techStackData.map((category) => (
      <div class="animate-fade-up">
        <div class="flex items-center gap-4 mb-5">
          <h3 class="text-xs font-bold tracking-[0.2em] text-muted-foreground whitespace-nowrap">
            {categoryNames[category.key]}
          </h3>
          <div class="h-px flex-1 bg-border"></div>
        </div>
        <div class="grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6">
          {category.items.map((item) => (
            <div class="group relative flex flex-col items-center gap-3 rounded-xl border border-border bg-card p-4 transition-all duration-300 hover:border-accent/50 hover:-translate-y-1 hover:shadow-[0_0_15px_rgba(6,182,212,0.1)]">
              <div class="flex h-12 w-12 items-center justify-center">
                <img
                  src={item.icon}
                  alt={item.name}
                  class="h-10 w-10 object-contain transition-transform duration-300 group-hover:scale-110"
                  loading="lazy"
                />
              </div>
              <span class="text-xs font-medium text-card-foreground text-center">{item.name}</span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
