---
import Sidebar from "../components/Sidebar.astro";
import "../styles/global.css";
import { siteConfig } from "../data/site.js";

const {
  lang,
  title,
  description = siteConfig.siteDescription,
  altHref,
  isProjectPage = false,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title ? `${title} — ${siteConfig.name}` : siteConfig.siteTitle}</title>
    <meta name="description" content={description} />

    <!--
      Script ini HARUS inline dan HARUS di <head>, supaya tema gelap/terang
      diterapkan SEBELUM halaman digambar (mencegah "kedipan" putih sesaat).
    -->
    <script is:inline>
      const storedTheme = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (storedTheme === "dark" || (!storedTheme && prefersDark)) {
        document.documentElement.classList.add("dark");
      }
    </script>

    <!-- Background Animation Scripts (Three.js and Vanta.js Net) -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js" defer></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/vanta/0.5.24/vanta.net.min.js" defer onload="window.initVanta && window.initVanta()"></script>
  </head>
  <body class="min-h-screen bg-background text-foreground relative overflow-x-hidden selection:bg-accent/20">
    <!-- Vanta Net Background Layer -->
    <div class="pointer-events-none fixed inset-0 z-0 transition-colors duration-300" id="vanta-bg" aria-hidden="true"></div>

    <Sidebar lang={lang} altHref={altHref} isProjectPage={isProjectPage} />

    <main class="relative z-10 mx-auto max-w-6xl px-6 pb-28 pt-16 md:pl-28 md:pr-8 md:pb-16">
      <slot />
    </main>

    <script is:inline>
      (() => {
        let vantaEffect = null;

        function initVanta() {
          const isDark = document.documentElement.classList.contains("dark");
          
          // Subtle colors matching light/dark backgrounds
          // Dark background matches user's custom color 0x0d0d1b and color 0x070709 (0x70709)
          // Light background keeps standard primary blue accent for readability
          const bgColor = isDark ? 0x0d0d1b : 0xf8fbff;
          const color = isDark ? 0x070709 : 0x2563eb;
          
          if (vantaEffect) {
            vantaEffect.destroy();
          }

          if (typeof VANTA !== "undefined" && typeof VANTA.NET === "function") {
            try {
              vantaEffect = VANTA.NET({
                el: "#vanta-bg",
                mouseControls: true,
                touchControls: true,
                gyroControls: false,
                minHeight: 200.00,
                minWidth: 200.00,
                scale: 1.00,
                scaleMobile: 1.00,
                color: color,
                backgroundColor: bgColor,
                points: 13.00,
                maxDistance: 20.00,
                spacing: 15.00,
                showDots: true
              });
            } catch (err) {
              console.error("Vanta Net failed to initialize", err);
            }
          }
        }

        window.initVanta = initVanta;

        // Initialize immediately if libraries are loaded
        if (typeof VANTA !== "undefined") {
          initVanta();
        } else if (document.readyState === "complete" || document.readyState === "interactive") {
          setTimeout(initVanta, 500); // retry after a short delay
        } else {
          window.addEventListener("DOMContentLoaded", initVanta);
          window.addEventListener("load", initVanta);
        }

        // Listen for class changes on document.documentElement to update background color dynamically
        const observer = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            if (mutation.attributeName === "class") {
              initVanta();
            }
          });
        });
        observer.observe(document.documentElement, { attributes: true });
      })();
    </script>
  </body>
</html>
