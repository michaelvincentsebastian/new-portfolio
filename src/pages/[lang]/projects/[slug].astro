---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Icon from "../../../components/Icon.astro";
import { t } from "../../../data/i18n.js";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { lang: project.data.lang, slug: project.data.projectSlug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { lang } = Astro.params;
const { Content } = await render(project);
const { title, tagline, year, status, techStack, github, demo } = project.data;
const label = t(lang).projects;

// Cari versi project yang sama di bahasa lain, untuk link toggle bahasa yang konsisten
const allProjects = await getCollection("projects");
const otherLang = lang === "en" ? "id" : "en";
const sameProjectOtherLang = allProjects.find(
  (p) => p.data.projectSlug === project.data.projectSlug && p.data.lang === otherLang
);
const altHref = sameProjectOtherLang
  ? `/${otherLang}/projects/${project.data.projectSlug}`
  : `/${otherLang}/`;
---

<BaseLayout lang={lang} altHref={altHref} title={title} isProjectPage={true}>
  <a
    href={`/${lang}/#projects`}
    class="inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-accent"
  >
    <Icon name="arrow-left" size={16} />
    {label.backToProjects}
  </a>

  <header class="animate-fade-up mt-6">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-3xl font-bold text-foreground md:text-4xl">{title}</h1>
      <span class="rounded border border-accent/25 bg-accent/5 px-2 py-0.5 text-xs font-mono font-semibold text-accent">
        {status}
      </span>
    </div>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted-foreground">{tagline}</p>

    <div class="mt-5 flex flex-wrap gap-4 text-sm text-muted-foreground">
      <span><strong class="text-foreground">{label.year}:</strong> <span class="font-mono">{year}</span></span>
    </div>

    <div class="mt-5 flex flex-wrap gap-2">
      {techStack.map((tech) => (
        <span class="rounded border border-border/60 bg-muted/30 px-2 py-0.5 text-xs font-mono font-medium text-muted-foreground">
          {tech}
        </span>
      ))}
    </div>

    {(github || demo) && (
      <div class="mt-6 flex flex-wrap gap-3">
        {github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-border/80 bg-card px-5 py-2.5 text-sm font-semibold text-foreground transition-colors hover:bg-muted"
          >
            <Icon name="github" size={16} />
            {label.viewOnGithub}
          </a>
        )}
        {demo && (
          <a
            href={demo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-accent-foreground transition-all hover:scale-[1.01]"
          >
            <Icon name="external-link" size={16} />
            {label.liveDemo}
          </a>
        )}
      </div>
    )}
  </header>

  <!-- Cover Image container (used in tabs script) -->
  {project.data.cover && (
    <div id="project-cover-container" class="animate-fade-up mt-10 overflow-hidden rounded-xl border border-border/80 shadow-sm">
      <img src={project.data.cover} alt={title} class="w-full object-cover" />
    </div>
  )}

  <div class="markdown-content animate-fade-up mt-10 max-w-3xl">
    <!-- Tab navigation structure -->
    <div id="project-tabs-container" class="hidden">
      <div class="flex border-b border-border/60 gap-1 md:gap-3 mb-8 overflow-x-auto pb-px">
        <button
          class="project-tab-btn border-b-2 border-accent text-accent px-4 py-3 text-sm font-semibold cursor-pointer whitespace-nowrap transition-colors"
          data-project-tab="general"
        >
          {label.tabGeneral}
        </button>
        <button
          class="project-tab-btn border-b-2 border-transparent text-muted-foreground hover:text-foreground px-4 py-3 text-sm font-semibold cursor-pointer whitespace-nowrap transition-colors"
          data-project-tab="technical"
        >
          {label.tabTechnical}
        </button>
        <button
          class="project-tab-btn border-b-2 border-transparent text-muted-foreground hover:text-foreground px-4 py-3 text-sm font-semibold cursor-pointer whitespace-nowrap transition-colors"
          data-project-tab="result"
        >
          {label.tabResult}
        </button>
      </div>

      <!-- Tab panels container -->
      <div id="project-tab-content-general" class="project-tab-panel block animate-fade-in"></div>
      <div id="project-tab-content-technical" class="project-tab-panel hidden animate-fade-in"></div>
      <div id="project-tab-content-result" class="project-tab-panel hidden animate-fade-in"></div>
    </div>

    <div id="raw-markdown-content">
      <Content />
    </div>
  </div>

  <script is:inline>
    (() => {
      const rawContent = document.getElementById("raw-markdown-content");
      const tabsContainer = document.getElementById("project-tabs-container");
      const panelGeneral = document.getElementById("project-tab-content-general");
      const panelTechnical = document.getElementById("project-tab-content-technical");
      const panelResult = document.getElementById("project-tab-content-result");
      const coverContainer = document.getElementById("project-cover-container");

      if (!rawContent || !tabsContainer || !panelGeneral || !panelTechnical || !panelResult) return;

      const children = Array.from(rawContent.children);
      let currentTab = "general";
      let hasTabs = false;

      children.forEach((child) => {
        const text = child.textContent.trim().toLowerCase();
        if (child.tagName === "H2" && (text === "general" || text === "umum")) {
          currentTab = "general";
          hasTabs = true;
          child.remove();
        } else if (child.tagName === "H2" && (text === "technical" || text === "teknis")) {
          currentTab = "technical";
          hasTabs = true;
          child.remove();
        } else if (child.tagName === "H2" && (text === "result" || text === "hasil")) {
          currentTab = "result";
          hasTabs = true;
          child.remove();
        } else {
          if (currentTab === "general") {
            panelGeneral.appendChild(child);
          } else if (currentTab === "technical") {
            panelTechnical.appendChild(child);
          } else if (currentTab === "result") {
            panelResult.appendChild(child);
          }
        }
      });

      if (hasTabs) {
        rawContent.remove();
        tabsContainer.classList.remove("hidden");

        // Move the cover image to the top of the Result tab
        if (coverContainer && panelResult) {
          coverContainer.classList.remove("mt-10");
          coverContainer.classList.add("mb-6");
          panelResult.insertBefore(coverContainer, panelResult.firstChild);
        }

        const tabBtns = document.querySelectorAll(".project-tab-btn");
        const panels = {
          general: panelGeneral,
          technical: panelTechnical,
          result: panelResult,
        };

        tabBtns.forEach((btn) => {
          btn.addEventListener("click", () => {
            const tabName = btn.getAttribute("data-project-tab");

            // Update active styles on buttons
            tabBtns.forEach((b) => {
              b.classList.remove("border-accent", "text-accent");
              b.classList.add("border-transparent", "text-muted-foreground");
            });
            btn.classList.add("border-accent", "text-accent");
            btn.classList.remove("border-transparent", "text-muted-foreground");

            // Show active panel
            Object.keys(panels).forEach((key) => {
              if (key === tabName) {
                panels[key].classList.remove("hidden");
                panels[key].classList.add("block");
              } else {
                panels[key].classList.add("hidden");
                panels[key].classList.remove("block");
              }
            });
          });
        });
      }
    })();
  </script>
</BaseLayout>
