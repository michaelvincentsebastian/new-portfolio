---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Icon from "../../../components/Icon.astro";
import { t } from "../../../data/i18n.js";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { lang: project.data.lang, slug: project.data.projectSlug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { lang } = Astro.params;
const { Content } = await render(project);
const { title, tagline, year, status, techStack, github, demo } = project.data;
const label = t(lang).projects;

// Cari versi project yang sama di bahasa lain, untuk link toggle bahasa yang konsisten
const allProjects = await getCollection("projects");
const otherLang = lang === "en" ? "id" : "en";
const sameProjectOtherLang = allProjects.find(
  (p) => p.data.projectSlug === project.data.projectSlug && p.data.lang === otherLang
);
const altHref = sameProjectOtherLang
  ? `/${otherLang}/projects/${project.data.projectSlug}`
  : `/${otherLang}/`;
---

<BaseLayout lang={lang} altHref={altHref} title={title} isProjectPage={true}>
  <a
    href={`/${lang}/#projects`}
    class="inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-accent"
  >
    <Icon name="arrow-left" size={16} />
    {label.backToProjects}
  </a>

  <header class="animate-fade-up mt-6">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-3xl font-bold text-foreground md:text-4xl">{title}</h1>
      <span class="rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-semibold text-accent">
        {status}
      </span>
    </div>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted-foreground">{tagline}</p>

    <div class="mt-5 flex flex-wrap gap-4 text-sm text-muted-foreground">
      <span><strong class="text-foreground">{label.year}:</strong> {year}</span>
    </div>

    <div class="mt-5 flex flex-wrap gap-2">
      {techStack.map((tech) => (
        <span class="rounded-md border border-border bg-card px-2.5 py-1 text-xs font-medium text-muted-foreground">
          {tech}
        </span>
      ))}
    </div>

    {(github || demo) && (
      <div class="mt-6 flex flex-wrap gap-3">
        {github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl border border-border bg-card px-5 py-2.5 text-sm font-semibold text-foreground transition-colors hover:bg-muted"
          >
            <Icon name="github" size={16} />
            {label.viewOnGithub}
          </a>
        )}
        {demo && (
          <a
            href={demo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl bg-accent px-5 py-2.5 text-sm font-semibold text-accent-foreground transition-transform hover:scale-105"
          >
            <Icon name="external-link" size={16} />
            {label.liveDemo}
          </a>
        )}
      </div>
    )}
  </header>

  {project.data.cover && (
    <div class="animate-fade-up mt-10 overflow-hidden rounded-2xl border border-border">
      <img src={project.data.cover} alt={title} class="w-full object-cover" />
    </div>
  )}

  <div class="markdown-content animate-fade-up mt-10 max-w-3xl">
    <Content />
  </div>
</BaseLayout>
